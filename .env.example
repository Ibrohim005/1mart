# Скопируйте в .env.local и заполните своими значениями.
# Файл .env.local в репозиторий не попадает.

# Публичный адрес сайта: из него собираются canonical, sitemap и og-теги
NUXT_PUBLIC_SITE_URL=https://zooelon.uz

# Базовый адрес API. Пока пусто — работает слой моков внутри Nuxt.
# Когда появится бэкенд, укажите его адрес, и слой api-mock убирается из extends.
NUXT_PUBLIC_API_BASE=

# Ключ Яндекс.Карт для выбора точки на карте в форме адреса.
# Выдаётся в кабинете разработчика Яндекса и привязывается к домену.
# Пока не задан, карта работает на OpenStreetMap.
NUXT_PUBLIC_YANDEX_MAPS_KEY=

# Ссылки на мобильное приложение. Google Play подставлен по умолчанию,
# App Store появится, когда выйдет версия под iOS: пока адрес пустой,
# бейдж App Store показывается картинкой и никуда не ведёт.
NUXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=uz.zoo.elon
NUXT_PUBLIC_APP_STORE_URL=

# Адрес лендинга для продавцов. По умолчанию он отдаётся этим же сервером
# по /sellers/; укажите домен, если лендинг переедет отдельно.
NUXT_PUBLIC_SELLER_LANDING_URL=

# Персональный токен Figma — нужен только для выгрузки макетов и иконок.
# Создать: Figma → Settings → Security → Personal access tokens.
# Токен личный, в репозиторий и в переписку не попадает.
FIGMA_TOKEN=

# Адрес zoo-backend для слоя-адаптера api-backend. Пока не задан, сайт
# работает на моках и слой не подключается вовсе.
# Значение включает префикс версии:
NUXT_UPSTREAM_BASE=https://api.zooelon.uz/api/v1

# Общий секрет с бэкендом (там SSR_THROTTLE_KEY). Без него анонимные лимиты
# бэкенда на OTP и вход считаются по IP — а IP у всех посетителей один,
# серверный. С ключом счёт идёт по номеру телефона.
NUXT_SSR_THROTTLE_KEY=
